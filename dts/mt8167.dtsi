/ {
    #address-cells = <2>;
    #size-cells = <2>;
    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <13000000>;
        cpu0: cpu@0 { device_type = "cpu"; compatible = "arm,cortex-a35"; reg = <0>; status = "disabled"; };
        cpu1: cpu@1 { device_type = "cpu"; compatible = "arm,cortex-a35"; reg = <1>; status = "disabled"; };
        cpu2: cpu@2 { device_type = "cpu"; compatible = "arm,cortex-a35"; reg = <2>; status = "disabled"; };
        cpu3: cpu@3 { device_type = "cpu"; compatible = "arm,cortex-a35"; reg = <3>; status = "disabled"; };
    };
    psci { compatible = "arm,psci-1.0"; method = "smc"; };
    soc {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        intc: interrupt-controller@10310000 {
            compatible = "arm,gic-400";
            reg = <0 0x10310000 0 0x1000>, <0 0x1032f000 0 0x2000>;
            unixnu,adt-name = "intc";
        };
        uart0: serial@11005000 {
            device_type = "serial";
            compatible = "mediatek,mt8167-uart", "mediatek,mt6577-uart", "ns16550a";
            reg = <0 0x11005000 0 0x1000>;
            reg-shift = <2>;
            reg-io-width = <4>;
            unixnu,adt-name = "uart0";
            status = "disabled";
        };
        mmc0: mmc@11120000 {
            compatible = "mediatek,mt8167-mmc";
            reg = <0 0x11120000 0 0x1000>;
            unixnu,adt-name = "mmc0";
            status = "disabled";
        };
    };
};
